# MarketMind AI - Environment Variables
# Copy this file to server/.env and fill in your values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/marketmind

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRE=7d

# Government of India API (data.gov.in - AGMARKNET)
# Register free at https://data.gov.in to get your API key
# Leave empty to run in Demo Mode with simulated prices
GOV_API_KEY=
GOV_API_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
GOV_API_BASE_URL=https://api.data.gov.in/resource

# Google Gemini AI API
# Get your key from https://makersuite.google.com/app/apikey
# Leave empty to use rule-based analysis instead of AI
GEMINI_API_KEY=

# Server Configuration
PORT=5000
NODE_ENV=development

# Price Monitoring
PRICE_CHECK_INTERVAL=6h
DEFAULT_STATE=Telangana
DEFAULT_MARKET=Hyderabad
ALERT_THRESHOLD=5
TARGET_MARGIN=10
